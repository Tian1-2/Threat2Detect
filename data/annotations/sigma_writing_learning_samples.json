      "sample_id": "SIGMA-LEARN-002",
      "task": "repair_boolean_logic",
      "source_ids": [
        "conditions",
        "bits"
      ],
      "input": "上述目标的候选写成 Image 为 bitsadmin.exe OR 命令包含 /transfer。",
      "expected_review": [
        "OR 使任一条件单独成立即可触发，超出目标。",
        "改为 AND；用仅满足单个条件的合成边界样本验证。"
      ],
      "review_status": "draft",
