      "source_ids": [
        "bits",
        "conditions"
      ],
      "input": "人工检测目标：进程为 bitsadmin.exe 且命令包含 /transfer。URL、落地文件名和父进程未知。",
      "expected_review": [
        "Image endswith \\bitsadmin.exe 与 CommandLine contains \" /transfer \" 必须 AND。",
        "不添加来源 URL、文件哈希或父进程限制。",
        "仅该变体，不声称覆盖完整 BITS 技术或恶意性。"
      ],
      "local_source": {
